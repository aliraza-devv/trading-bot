# Copy this file to .env.local (never commit .env.local) and fill in the key.
# Get a free key in ~1 minute at https://twelvedata.com/pricing - then check that your plan
# includes XAU/USD 15-minute data (see README, "Data source").
TWELVEDATA_API_KEY=

# Optional ---------------------------------------------------------------------------------
# Your plan's per-minute request limit. Free plan = 8. Requests are spaced to stay under it.
# TWELVEDATA_CREDITS_PER_MIN=8
# Longest date range one request may ask for (each month of data = 1 request).
# 180 days = 6 requests = about 45 seconds the first time on the free plan; later loads are cached.
# TWELVEDATA_MAX_DAYS=180
# What the API's candle timestamps mean: "open" (default) or "close". Check once - see README.
# TWELVEDATA_BAR_TIME=open
